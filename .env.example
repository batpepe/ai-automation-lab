# Copy to .env and adjust. Never commit .env, and never put a real value here.
# Settings arrive with the phase that uses them; this file tracks what exists.

# --- Phase 0: process configuration -----------------------------------------
# Anything starting with OPSAGENT_ that is not a known setting is a startup
# error, so a typo here fails loudly instead of silently keeping the default.

# local | cluster. Also decides log rendering unless OPSAGENT_LOG_JSON is set.
OPSAGENT_ENVIRONMENT=local

# DEBUG | INFO | WARNING | ERROR | CRITICAL
OPSAGENT_LOG_LEVEL=INFO

# Leave unset to follow OPSAGENT_ENVIRONMENT: console locally, JSON in cluster.
# OPSAGENT_LOG_JSON=false
